# Local dev only — copy to .env.local and fill in. Do not commit .env.local.
#
# Two products in this repo:
#   1. Portfolio tracker  (/)             — uses NEXT_PUBLIC_FINNHUB_KEY (browser fetch)
#   2. Research section   (/research)     — uses every other key below
#
# Secrets are split between Vercel (site) and GitHub Actions (daily scan worker).
# Comments below show which side each secret goes to. Most go to BOTH.
# See docs/RESEARCH-SETUP.md for the Hour-1 setup runbook.


# --- BOTH Vercel + GHA ---

# Neon Postgres connection string. https://neon.tech (free tier).
DATABASE_URL=

# Shared secret for GHA → Vercel revalidation POST (POST /api/revalidate-research).
# Generate: openssl rand -hex 32
CRON_SECRET=


# --- Vercel ONLY (build/runtime) ---

# Edge Middleware Basic Auth gate during the 14-day shakedown window.
# Choose a passphrase. ASCII only. Username is hardcoded in middleware.ts to "operator".
ADMIN_PASSWORD=

# Public-site Finnhub key (browser fetch — portfolio tab. Pre-existing.)
# Sign up free at https://finnhub.io/register — no credit card needed.
# If set, this key takes priority over anything saved via the UI.
NEXT_PUBLIC_FINNHUB_KEY=


# --- GHA ONLY (scripts/scan.ts daily worker) ---

# Server-side Finnhub key for the scan worker. Separate from NEXT_PUBLIC_FINNHUB_KEY above.
# Same Finnhub account is fine; keeping the keys separate avoids leaking the server
# key into the browser bundle.
FINNHUB_API_KEY=

# Daily-candle source. Default `auto` = Tiingo if TIINGO_API_KEY is set,
# else Yahoo (which 429s some residential IPs in 2025). Explicit values:
#   tiingo  — Tiingo REST API (recommended; sign up below)
#   yahoo   — Yahoo Finance unofficial chart endpoint, no key
#   finnhub — Finnhub /stock/candle, paid tier only (free dropped it 2024Q3)
# CANDLE_SOURCE=

# Tiingo daily-prices key. https://www.tiingo.com/account/api/token (free, no card).
# Free tier: 50 unique symbols/hour, 500/day, 1000 req/hr — enough for one
# S&P 100 scan/day at the default 1.1s pacing.
TIINGO_API_KEY=

# Run the scan without daily candles. The `min-history` framework rule
# becomes a no-op and forward-return windows lose their pick-date close.
# Use only when the candle source is wedged and a degraded scan tonight
# beats no scan at all. Snapshots tagged `[SKIP_HISTORY]` in reason_text.
# SKIP_HISTORY=1

# Google Gemini API key. https://aistudio.google.com/apikey (free tier).
# Model used: gemini-2.5-flash. See lib/research/explain.ts.
GEMINI_API_KEY=

# SEC EDGAR requires a User-Agent string. Format: "FirstLast email@host"
# Anonymous or fake values get rate-limited. Use a real contact.
SEC_EDGAR_USER_AGENT=
